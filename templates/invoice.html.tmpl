<!DOCTYPE html>
<html lang="{{.Locale}}">
<head>
<meta charset="UTF-8">
<title>{{.Strings.Title}} {{.InvoiceNumber}}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Sans+KR:wght@400;500;700&family=Inter:wght@400;500;700&display=swap');

  @page {
    size: A4;
    margin: 20mm 15mm 25mm 15mm;
    @bottom-center {
      content: "{{.Strings.Page}} " counter(page) " / " counter(pages);
      font-family: 'Inter', 'Noto Sans KR', 'Noto Sans JP', sans-serif;
      font-size: 9pt;
      color: #888;
    }
  }

  * { box-sizing: border-box; }

  body {
    font-family: 'Inter', 'Noto Sans KR', 'Noto Sans JP', sans-serif;
    font-size: 10pt;
    line-height: 1.55;
    color: #1a1a1a;
    margin: 0;
    font-feature-settings: "palt" 1;
  }

  h1 {
    font-size: 26pt;
    margin: 0 0 4pt 0;
    letter-spacing: 0.04em;
    font-weight: 700;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 2px solid #1a1a1a;
    padding-bottom: 10pt;
    margin-bottom: 18pt;
  }

  .invoice-no { color: #666; font-size: 9pt; }

  .meta { text-align: right; font-size: 9pt; }
  .meta .row { margin-bottom: 2pt; }
  .meta .label { color: #888; margin-right: 6pt; }
  .meta .value { font-weight: 500; }

  .parties { display: flex; gap: 16pt; margin-bottom: 18pt; }
  .party {
    flex: 1;
    padding: 12pt;
    background: #f6f6f8;
    border-radius: 4pt;
  }
  .party h3 {
    margin: 0 0 8pt 0;
    font-size: 9pt;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
  }
  .party .name { font-size: 12pt; font-weight: 700; margin-bottom: 2pt; }
  .party .line { font-size: 9.5pt; color: #444; }

  table.items {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }
  /* CSS Paged Media: thead 페이지 반복 */
  table.items thead { display: table-header-group; }
  table.items tr { break-inside: avoid; page-break-inside: avoid; }

  table.items th {
    background: #1a1a1a;
    color: #fff;
    padding: 7pt 8pt;
    font-size: 9pt;
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  table.items th.num { text-align: right; }
  table.items th.center { text-align: center; }

  table.items td {
    padding: 7pt 8pt;
    border-bottom: 1px solid #e5e5e5;
    font-size: 10pt;
    vertical-align: top;
  }
  table.items td.num {
    text-align: right;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: "tnum" 1, "lnum" 1;
    white-space: nowrap;
  }
  table.items td.center { text-align: center; }
  table.items td .sku { color: #888; font-size: 8.5pt; margin-top: 2pt; }

  .summary-wrap {
    margin-top: 14pt;
    display: flex;
    justify-content: flex-end;
  }
  table.summary {
    width: 45%;
    border-collapse: collapse;
  }
  table.summary td { padding: 5pt 8pt; font-size: 10pt; }
  table.summary td.label { color: #666; }
  table.summary td.num {
    text-align: right;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: "tnum" 1, "lnum" 1;
    white-space: nowrap;
  }
  table.summary tr.total td {
    font-size: 13pt;
    font-weight: 700;
    border-top: 2px solid #1a1a1a;
    padding-top: 9pt;
    color: #1a1a1a;
  }

  .notes {
    margin-top: 26pt;
    padding: 12pt 14pt;
    background: #fffbe6;
    border-left: 4pt solid #f0c000;
    font-size: 9pt;
    line-height: 1.6;
  }

  .footer-sign {
    margin-top: 30pt;
    display: flex;
    justify-content: flex-end;
    gap: 30pt;
  }
  .stamp-box {
    width: 70pt; height: 70pt;
    border: 1.5pt dashed #bbb;
    border-radius: 4pt;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #aaa;
    font-size: 9pt;
  }
</style>
</head>
<body>

<div class="header">
  <div>
    <h1>{{.Strings.Title}}</h1>
    <div class="invoice-no">{{.Strings.InvoiceNo}}: <strong>{{.InvoiceNumber}}</strong></div>
  </div>
  <div class="meta">
    <div class="row"><span class="label">{{.Strings.IssueDate}}</span><span class="value">{{.IssueDate}}</span></div>
    <div class="row"><span class="label">{{.Strings.DueDate}}</span><span class="value">{{.DueDate}}</span></div>
  </div>
</div>

<div class="parties">
  <div class="party">
    <h3>{{.Strings.From}}</h3>
    <div class="name">{{.From.Name}}</div>
    <div class="line">{{.From.Address}}</div>
    {{if .From.TaxID}}<div class="line">{{.Strings.TaxID}}: {{.From.TaxID}}</div>{{end}}
    {{if .From.Contact}}<div class="line">{{.From.Contact}}</div>{{end}}
  </div>
  <div class="party">
    <h3>{{.Strings.To}}</h3>
    <div class="name">{{.To.Name}}</div>
    <div class="line">{{.To.Address}}</div>
    {{if .To.TaxID}}<div class="line">{{.Strings.TaxID}}: {{.To.TaxID}}</div>{{end}}
    {{if .To.Contact}}<div class="line">{{.To.Contact}}</div>{{end}}
  </div>
</div>

<table class="items">
  <thead>
    <tr>
      <th class="center" style="width:5%">#</th>
      <th style="width:50%">{{.Strings.Description}}</th>
      <th class="num" style="width:10%">{{.Strings.Quantity}}</th>
      <th class="num" style="width:17%">{{.Strings.UnitPrice}}</th>
      <th class="num" style="width:18%">{{.Strings.Amount}}</th>
    </tr>
  </thead>
  <tbody>
    {{range $i, $item := .Items}}
    <tr>
      <td class="center">{{inc $i}}</td>
      <td>
        {{$item.Description}}
        {{if $item.SKU}}<div class="sku">SKU: {{$item.SKU}}</div>{{end}}
      </td>
      <td class="num">{{$item.Quantity}}</td>
      <td class="num">{{money $item.UnitPrice $.Currency}}</td>
      <td class="num">{{money $item.Amount $.Currency}}</td>
    </tr>
    {{end}}
  </tbody>
</table>

<div class="summary-wrap">
  <table class="summary">
    <tr>
      <td class="label">{{.Strings.Subtotal}}</td>
      <td class="num">{{money .Subtotal .Currency}}</td>
    </tr>
    <tr>
      <td class="label">{{.Strings.Tax}} ({{.TaxRate}}%)</td>
      <td class="num">{{money .Tax .Currency}}</td>
    </tr>
    <tr class="total">
      <td class="label">{{.Strings.Total}}</td>
      <td class="num">{{money .Total .Currency}}</td>
    </tr>
  </table>
</div>

{{if .Notes}}
<div class="notes">{{.Notes}}</div>
{{end}}

<div class="footer-sign">
  <div class="stamp-box">{{.Strings.Stamp}}</div>
</div>

</body>
</html>
